flowchart LR
    subgraph APP["Custom Vendor Application"]
        BIZ["Business Logic & Auth Middleware"]
        SECLOG["SecurityLogger Wrapper\n• Canonical JSON Schema\n• OWASP Event Prefix\n• Secret/PII Redaction\n• CWE-117 Sanitization\n• UTC ISO-8601 + Correlation ID"]
        OPLOG["Operational Logger\n• DEBUG / TRACE\n• Health Checks (/healthz)\n• Latency & Stack Traces"]
    end

    subgraph PIPE["Log Collector / Router (OTel / Fluent Bit / AMA)"]
        ROUTE{"Route by\nstream field"}
        SCRUB["Secondary PII Scrub\n& Enrichment"]
    end

    subgraph SOC["Government SOC & SIEM (Write-Only Sink)"]
        SIEM["SIEM Analytics Tables\n(Sentinel / Splunk / Elastic)\n12+ Month Searchable Retention\nACSC ISM-1405 / ISM-1988"]
        DETECT["Day-1 Detection Rules\n• Brute-Force -> Success\n• Authz / IDOR Probing\n• Privilege Escalation\n• Bulk Export Anomaly\n• Heartbeat Dropout"]
        ANALYST["SOC Analysts & SOAR\nHigh-Signal Triage"]
    end

    subgraph OPS["Operational Observability"]
        APM["APM / Metrics / Data Lake\n7–30 Day Retention\nLow-Cost Storage"]
    end

    BIZ -->|"Security transitions\n(stream: security)"| SECLOG
    BIZ -->|"Debug, perf, health\n(stream: operational)"| OPLOG
    SECLOG --> ROUTE
    OPLOG --> ROUTE
    ROUTE -->|"stream == 'security'\n(Never sampled)"| SCRUB
    ROUTE -->|"stream != 'security'\n(Sampled / rotated)"| APM
    SCRUB --> SIEM
    SIEM --> DETECT
    DETECT --> ANALYST
